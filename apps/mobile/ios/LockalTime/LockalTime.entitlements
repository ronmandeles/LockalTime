<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Phase 3 task 3.6 (backlog.md): not yet referenced by the Xcode project —
  "Signing & Capabilities" > App Groups (group.com.lockaltime.app) and
  Family Controls must be added to the LockalTime target manually in Xcode,
  which will generate/link an entitlements file itself (can point it at
  this one). Family Controls requires Apple's entitlement approval (task
  3.7's application) before it will actually work on a real device/App
  Store build, even with this file wired in correctly.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lockaltime.app</string>
	</array>
	<key>com.apple.developer.family-controls</key>
	<true/>
</dict>
</plist>
