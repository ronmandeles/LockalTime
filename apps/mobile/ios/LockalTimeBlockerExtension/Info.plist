<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Phase 3 task 3.6 (backlog.md): reference Info.plist for the
  DeviceActivityMonitor extension target — NOT wired into any real Xcode
  target in this repo (see DeviceActivityMonitorExtension.swift's header).
  When the real target is created via Xcode's "Device Activity Monitor
  Extension" template, Xcode generates its own Info.plist with this same
  NSExtension shape; this file exists so the required keys are documented
  and version-controlled even before a Mac is available to generate them.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>LockalTime Blocker</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.deviceactivity.monitor-extension</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).DeviceActivityMonitorExtension</string>
	</dict>
</dict>
</plist>
