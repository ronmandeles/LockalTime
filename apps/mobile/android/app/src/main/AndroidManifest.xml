<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Phase 4 task 11: BlockerForegroundService polls ConnectivityManager
         each cycle to detect the 30-minute offline cutoff (ARCHITECTURE.md
         §4). Normal-protection-level permission, no runtime prompt needed. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- react-native-vision-camera (Phase 3 task 3.5): real QR-code
         scanning on the Scan screen. Normal runtime permission, requested
         via useCameraPermission()'s requestPermission() — not a Settings
         redirect like Usage Access/Overlay above. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Usage Access: a "special app op", granted only via Settings, never a
         runtime dialog — Play's protected-permission lint would otherwise
         flag this as unrequestable at install time. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ (API 34) requires a foregroundServiceType; "specialUse"
         is the closest fit (blocking distracting apps during a joined
         session isn't camera/location/media-playback/etc.) and requires
         both this permission and the PROPERTY_SPECIAL_USE_FGS_SUBTYPE
         declaration below the service element. Re-verify against whatever
         Android version is current by ship time — this targets API 34's
         documented requirement as of this writing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Phase 9 (docs/BLOCKLIST_SELECTION_PLAN.md): the Create Session picker
         offers a fixed, bundled catalog of well-known apps
         (src/config/app-catalog.json) on BOTH platforms, and filters it to the
         ones the host actually has. This block is how Android answers "is this
         installed?" for exactly those packages and nothing else - the
         sanctioned narrow alternative to QUERY_ALL_PACKAGES.
         It deliberately replaced QUERY_ALL_PACKAGES (owner decision
         2026-08-08, superseding the full-enumeration choice of 2026-08-07):
         parity with iOS was the goal, and losing the RESTRICTED permission
         means no Play Console declaration, no weeks of review, and no risk of
         a refusal blocking release.
         Exactly mirrors iOS's LSApplicationQueriesSchemes. Generated from the
         catalog; drift is caught by __tests__/native-config.test.ts, not by a
         build error. -->
