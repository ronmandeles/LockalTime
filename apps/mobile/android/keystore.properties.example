# Phase 7 (Release Prep) release-signing config — see docs/DEPLOYMENT.md's
# "Android release signing" runbook for how to generate a real keystore.
#
# Copy this file to `keystore.properties` (same directory, gitignored) and
# fill in real values. NEVER commit the real file or the .keystore it points
# to — both are in .gitignore already.
RELEASE_STORE_FILE=release.keystore
RELEASE_STORE_PASSWORD=changeme
RELEASE_KEY_ALIAS=lockaltime
RELEASE_KEY_PASSWORD=changeme
