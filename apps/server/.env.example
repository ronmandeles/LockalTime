# Copy to .env for local dev (gitignored — real .env is never committed).
# apps/server/src/config/env.ts validates these at boot and crashes with a
# clear message if any is missing or malformed.

# Supabase CLI's standard local-development demo values (`supabase start`
# prints the same ones) — public by design, safe in this example file. Same
# convention as apps/mobile/src/config/supabase-config.ts's anon key.
# No auth secret lives here: Supabase signs access tokens asymmetrically
# (ES256) and require-auth verifies them against its public JWKS
# (auto-fetched from SUPABASE_URL — see src/services/supabase-jwks.ts).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Project-specific — not a Supabase default. Generate your own for local dev,
# e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SIGNING_SECRET=replace-with-a-locally-generated-32-plus-character-secret

PORT=3000
